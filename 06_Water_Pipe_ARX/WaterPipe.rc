IDD_PIPE_DIALOG DIALOGEX 0, 0, 300, 190
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "VCI - ONG NUOC 2D"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "ONG NUOC 2D", -1, 18, 12, 150, 16

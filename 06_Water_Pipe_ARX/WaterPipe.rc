    LTEXT           "Chieu day ong (mm):", -1, 18, 77, 135, 12
    EDITTEXT        IDC_WALL, 165, 74, 105, 18, ES_AUTOHSCROLL
    LTEXT           "Chieu day cut (mm):", -1, 18, 102, 135, 12
    EDITTEXT        IDC_ELBOW, 165, 99, 105, 18, ES_AUTOHSCROLL
    LTEXT           "Ban kinh tim cut (mm):", -1, 18, 127, 135, 12
